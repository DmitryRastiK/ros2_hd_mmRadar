<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

    <!-- Odom link (корень без инерции) -->
    <!-- <link name="odom" /> -->

    <!-- BASE LINK -->

    <link name="base_link"></link>

    <!-- BASE_FOOTPRINT LINK -->

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link" />
        <child link="base_footprint" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <link name="base_footprint"></link>

    <!-- CHASSIS LINK -->

    <link
        name="robot_base_link">
        <inertial>
            <origin
                xyz="0 -4.11883012561842E-06 0.0252378978021215"
                rpy="0 0 0" />
            <mass
                value="21.8883477564347" />
            <inertia
                ixx="0.0866622622559118"
                ixy="-5.1803074903493E-19"
                ixz="3.96578785626232E-19"
                iyy="0.210523672340639"
                iyz="-8.49606476359062E-16"
                izz="0.294519882417361" />
        </inertial>
        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="file://$(find my_robot)/meshes/robot_base_link.STL" />
            </geometry>
            <material
                name="">
                <color
                    rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
            </material>
        </visual>
        <collision>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="file://$(find my_robot)/meshes/robot_base_link.STL" />
            </geometry>
        </collision>
    </link>

    <joint name="robot_base_link_joint" type="fixed">
        <parent link="base_link" />
        <child link="robot_base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <gazebo reference="robot_base_link">
        <material>Gazebo/White</material>
    </gazebo>

    <link
        name="left_front_wheel">
        <inertial>
            <origin
                xyz="4.0856E-14 3.4686E-05 -0.022529"
                rpy="0 0 0" />
            <mass
                value="2.138" />
            <inertia
                ixx="0.0017728"
                ixy="-8.6207E-15"
                ixz="-1.5501E-15"
                iyy="0.0017731"
                iyz="6.4327E-07"
                izz="0.0028012" />
        </inertial>
        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="file://$(find my_robot)/meshes/wheel.STL" />
            </geometry>
            <material
                name="">
                <color
                    rgba="1 1 0 1" />
            </material>
        </visual>
        <collision>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="file://$(find my_robot)/meshes/wheel.STL" />
            </geometry>
        </collision>
    </link>

    <joint
        name="left_front_wheel_joint"
        type="continuous">
        <origin
            xyz="0.13577 0.175 0.024846"
            rpy="1.5708 0 0" />
        <parent
            link="robot_base_link" />
        <child
            link="left_front_wheel" />
        <axis
            xyz="0 0 -1" />
        <dynamics
            damping="0.1"
            friction="0.1" />
        <command_interface name="velocity" /><!-- управляем скорость колеса -->
        <state_interface name="position" /><!-- состояние: пройденный угол -->
        <state_interface name="velocity" /><!-- состояние: текущая скорость -->
    </joint>

    <gazebo reference="left_front_wheel">
        <material>Gazebo/Yellow</material>
    </gazebo>

    <link
        name="left_rear_wheel">
        <inertial>
            <origin
                xyz="4.0801E-14 3.4686E-05 -0.022529"
                rpy="0 0 0" />
            <mass
                value="2.138" />
            <inertia
                ixx="0.0017728"
                ixy="-8.6211E-15"
                ixz="-1.5501E-15"
                iyy="0.0017731"
                iyz="6.4327E-07"
                izz="0.0028012" />
        </inertial>
        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="file://$(find my_robot)/meshes/wheel.STL" />
            </geometry>
            <material
                name="">
                <color
                    rgba="1 1 0 1" />
            </material>
        </visual>
        <collision>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="file://$(find my_robot)/meshes/wheel.STL" />
            </geometry>
        </collision>
    </link>

    <joint
        name="left_rear_wheel_joint"
        type="continuous">
        <origin
            xyz="-0.12917 0.175 0.024846"
            rpy="1.5708 0 0" />
        <parent
            link="robot_base_link" />
        <child
            link="left_rear_wheel" />
        <axis
            xyz="0 0 -1" />
        <dynamics
            damping="0.1"
            friction="0.1" />
        <command_interface name="velocity" /><!-- управляем скорость колеса -->
        <state_interface name="position" /><!-- состояние: пройденный угол -->
        <state_interface name="velocity" /><!-- состояние: текущая скорость -->
    </joint>

    <link
        name="right_front_wheel">
        <inertial>
            <origin
                xyz="4.0828E-14 -3.4686E-05 0.022529"
                rpy="0 0 0" />
            <mass
                value="2.138" />
            <inertia
                ixx="0.0017728"
                ixy="8.6216E-15"
                ixz="1.55E-15"
                iyy="0.0017731"
                iyz="6.4327E-07"
                izz="0.0028012" />
        </inertial>
        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 ${pi} 0" />
            <geometry>
                <mesh
                    filename="file://$(find my_robot)/meshes/wheel.STL" />
            </geometry>
            <material
                name="">
                <color
                    rgba="1 1 0 1" />
            </material>
        </visual>
        <collision>
            <origin
                xyz="0 0 0"
                rpy="0 ${pi} 0" />
            <geometry>
                <mesh
                    filename="file://$(find my_robot)/meshes/wheel.STL" />
            </geometry>
        </collision>
    </link>

    <joint
        name="right_front_wheel_joint"
        type="continuous">
        <origin
            xyz="0.13577 -0.175 0.025154"
            rpy="1.5708 0 0" />
        <parent
            link="robot_base_link" />
        <child
            link="right_front_wheel" />
        <axis
            xyz="0 0 -1" />
        <dynamics
            damping="0.1"
            friction="0.1" />
        <command_interface name="velocity" /><!-- управляем скорость колеса -->
        <state_interface name="position" /><!-- состояние: пройденный угол -->
        <state_interface name="velocity" /><!-- состояние: текущая скорость -->
    </joint>

    <link
        name="right_rear_wheel">
        <inertial>
            <origin
                xyz="4.0856E-14 -3.4686E-05 0.022529"
                rpy="0 0 0" />
            <mass
                value="2.138" />
            <inertia
                ixx="0.0017728"
                ixy="8.621E-15"
                ixz="1.55E-15"
                iyy="0.0017731"
                iyz="6.4327E-07"
                izz="0.0028012" />
        </inertial>
        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 ${pi} 0" />
            <geometry>
                <mesh
                    filename="file://$(find my_robot)/meshes/wheel.STL" />
            </geometry>
            <material
                name="">
                <color
                    rgba="1 1 0 1" />
            </material>
        </visual>
        <collision>
            <origin
                xyz="0 0 0"
                rpy="0 ${pi} 0" />
            <geometry>
                <mesh
                    filename="file://$(find my_robot)/meshes/wheel.STL" />
            </geometry>
        </collision>
    </link>

    <joint
        name="right_rear_wheel_joint"
        type="continuous">
        <origin
            xyz="-0.12917 -0.175 0.025154"
            rpy="1.5708 0 0" />
        <parent
            link="robot_base_link" />
        <child
            link="right_rear_wheel" />
        <axis
            xyz="0 0 -1" />
        <dynamics
            damping="0.1"
            friction="0.1" />
        <command_interface name="velocity" /><!-- управляем скорость колеса -->
        <state_interface name="position" /><!-- состояние: пройденный угол -->
        <state_interface name="velocity" /><!-- состояние: текущая скорость -->
    </joint>

    <ros2_control name="my_robot_hardware" type="system">
        <hardware>
            <!-- Подключаем эмуляцию аппаратной части: GenericSystem с вычислением динамики -->
            <plugin>mock_components/GenericSystem</plugin>
            <param name="update_rate" type="int">50</param>
            <param name="calculate_dynamics" type="bool">true</param>
        </hardware>
        <!-- Описание управляемых шарниров -->
        <joint name="left_front_wheel_joint">
            <command_interface name="velocity" /><!-- управляем скорость колеса -->
            <state_interface name="position" /><!-- состояние: пройденный угол -->
            <state_interface name="velocity" /><!-- состояние: текущая скорость -->
        </joint>
        <joint name="left_rear_wheel_joint">
            <command_interface name="velocity" /><!-- управляем скорость колеса -->
            <state_interface name="position" /><!-- состояние: пройденный угол -->
            <state_interface name="velocity" /><!-- состояние: текущая скорость -->
        </joint>
        <joint name="right_front_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="right_rear_wheel_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </ros2_control>

    <gazebo reference="left_rear_wheel">
        <material>Gazebo/Yellow</material>
    </gazebo>

    <gazebo reference="right_front_wheel">
        <material>Gazebo/Yellow</material>
    </gazebo>

    <gazebo reference="right_rear_wheel">
        <material>Gazebo/Yellow</material>
    </gazebo>


</robot>